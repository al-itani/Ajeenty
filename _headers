# Cloudflare Pages response headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Link preview image: always served as a real JPEG so WhatsApp, Instagram and Facebook can show it
/og.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# Fonts never change: cache for a year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Brand images, menu illustrations and photos: cache for a day
/img/*
  Cache-Control: public, max-age=86400
/photos/*
  Cache-Control: public, max-age=86400

/site.webmanifest
  Content-Type: application/manifest+json
